[Unit]
Description=ZFS backup %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/modd-zfs-backup/%i.conf
ExecStart=/usr/local/bin/modd-zfs-backup --name %i --source=${SOURCE} --dest=${DEST} --ssh-key=${SSH_KEY} --recursive=${RECURSIVE} --full=${FULL} --healthcheck-url=${HEALTHCHECK_URL}
TimeoutStartSec=infinity
UMask=0077
